# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional overrides
# MAX_DISTANCE=0.6
# RATE_PER_MINUTE=10
# IP_DAILY_CAP=40
# GEMINI_DAILY_BUDGET=400   # all visitors combined; free tier allows 500/day
# GEMINI_PER_MINUTE=12      # free tier allows 15/min
# FOLLOWUP_MODE=concat      # none | concat | llm
# HISTORY_TURNS=3